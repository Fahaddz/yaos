{
	"name": "yaos",
	"version": "1.6.1",
	"description": "A zero-terminal, real-time sync engine powered by your own Cloudflare Worker.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"build:qa-product": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs qa-product",
		"build:server-release": "node build-server-release.mjs",
		"test:server-update-local": "npm run build:server-release && node tests/server-update-local.mjs",
		"test:regressions": "npm run guard:no-src-js-artifacts && npm run guard:concurrency-drift && npm run guard:qa-isolation && npm run guard:schema-version && node tests/run-regressions.mjs",
		"test:ci": "npm run test:regressions && npm run test:integration:worker",
		"test:integration:worker": "node tests/worker-integration.mjs",
		"build:harness": "node qa/obsidian-harness/esbuild.mjs production",
		"qa:smoke-ready": "npm run build && npm run build:qa-product && npm run build:harness && node qa/controllers/run-smoke-ready.mjs",
		"dev:harness": "node qa/obsidian-harness/esbuild.mjs",
		"qa:manifest": "bun run qa/scripts/manifest.ts",
		"qa:compare": "bun run qa/scripts/compare.ts",
		"qa:analyze": "bun run qa/analyzers/analyzer.ts",
		"qa:prepare": "bun run qa/scripts/prepare-vault.ts",
		"qa:obsidian": "bun run qa/controllers/single-device.ts",
		"qa:two-device": "bun run qa/controllers/two-device.ts",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"lint:changed": "node scripts/lint-changed.mjs",
		"lint:staged": "node scripts/lint-staged.mjs",
		"lint:worktree": "node scripts/lint-staged.mjs --worktree",
		"verify:bundles": "npm run build && npm run guard:production-bundles:transitional",
		"guard:production-bundles": "node scripts/guard-production-bundles.mjs",
		"guard:production-bundles:strict": "node scripts/guard-production-bundles.mjs",
		"guard:production-bundles:transitional": "node scripts/guard-production-bundles.mjs --transitional",
		"guard:no-src-js-artifacts": "node scripts/guard-no-src-js-artifacts.mjs",
		"guard:no-tracked-generated-artifacts": "node scripts/guard-no-tracked-generated-artifacts.mjs",
		"guard:concurrency-drift": "node scripts/guard-concurrency-drift.mjs",
		"guard:qa-isolation": "node scripts/guard-qa-isolation.mjs",
		"guard:schema-version": "node scripts/guard-schema-version.mjs",
		"clean:src-js-artifacts": "find src -name '*.js' -o -name '*.js.map' | xargs rm -f 2>/dev/null; echo 'cleaned'"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@codemirror/state": "^6.0.0",
		"@codemirror/view": "^6.0.0",
		"@eslint/js": "9.30.1",
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"playwright": "^1.60.0",
		"tslib": "^2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"ws": "8.21.3"
	},
	"dependencies": {
		"fast-diff": "1.3.0",
		"fflate": "^0.8.2",
		"js-yaml": "4.3.1",
		"obsidian": "1.8.7",
		"partyserver": "0.3.2",
		"qrcode": "^1.5.4",
		"y-codemirror.next": "^0.3.5",
		"y-indexeddb": "^9.0.12",
		"y-partyserver": "2.1.2",
		"yjs": "^13.6.20"
	}
}
